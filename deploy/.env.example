# 部署時複製為 deploy/.env 並填入真實值，deploy/.env 已被 .gitignore 排除，不要 commit。

# Telegram Bot API token（必填，缺少時 docker compose 會直接失敗）
TELEGRAM_ACCESS_TOKEN=

# Finnhub API key，用於 /usprice 美股報價指令（必填，缺少時 docker compose 會直接失敗）
FINNHUB_API_KEY=

# 選填，容器內 log 目錄，預設 /data/vault/logs/
INFO_LOG_PATH=/data/vault/logs/
ERROR_LOG_PATH=/data/vault/logs/

# 選填，NAS 上實際掛載的 log 目錄，預設 /share/Container/stockbot/logs
STOCKBOT_LOG_DIR=/share/Container/stockbot/logs
